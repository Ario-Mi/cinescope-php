        <mxCell id="tlDhsTLVG-M8obE5rz7a-216" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;align=left;" value="&lt;div style=&quot;background-color: rgb(255, 255, 255); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; line-height: 18px; white-space: pre;&quot;&gt;&lt;div style=&quot;line-height: 18px;&quot;&gt;&lt;div style=&quot;background-color: rgb(255, 255, 255); line-height: 18px;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(51, 255, 51));&quot;&gt;-- JOIN + COUNT(id): wie viele Actors hat jeder Film?&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;SELECT&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    films.id,&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    films.title,&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    COUNT(films_actors.id) &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;AS&lt;/span&gt; actors_count&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;FROM&lt;/span&gt; films&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;LEFT JOIN&lt;/span&gt; films_actors &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;ON&lt;/span&gt; films.id = films_actors.films_id&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;GROUP BY&lt;/span&gt; films.id, films.title&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;ORDER BY&lt;/span&gt; films.title;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="600" x="260" y="2680" as="geometry" />
        </mxCell>
        <mxCell id="tlDhsTLVG-M8obE5rz7a-217" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;align=left;" value="&lt;div style=&quot;background-color: rgb(255, 255, 255); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; line-height: 18px; white-space: pre;&quot;&gt;&lt;div style=&quot;line-height: 18px;&quot;&gt;&lt;div style=&quot;background-color: rgb(255, 255, 255); line-height: 18px;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(51, 255, 51));&quot;&gt;-- Detailansicht mit JOIN (Genre, Director, Writer, Actors)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;SELECT&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    films.id,&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    films.title,&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    films.year,&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    films.runtime,&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    films.imdbRating,&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    GROUP_CONCAT(&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;DISTINCT&lt;/span&gt; genres.genre SEPARATOR &lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&#39;, &#39;&lt;/span&gt;) &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;AS&lt;/span&gt; genres,&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    GROUP_CONCAT(&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;DISTINCT&lt;/span&gt; directors.director SEPARATOR &lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&#39;, &#39;&lt;/span&gt;) &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;AS&lt;/span&gt; directors,&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    GROUP_CONCAT(&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;DISTINCT&lt;/span&gt; writers.writer SEPARATOR &lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&#39;, &#39;&lt;/span&gt;) &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;AS&lt;/span&gt; writers,&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    GROUP_CONCAT(&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;DISTINCT&lt;/span&gt; actors.actor SEPARATOR &lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&#39;, &#39;&lt;/span&gt;) &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;AS&lt;/span&gt; actors&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;FROM&lt;/span&gt; films&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;LEFT JOIN&lt;/span&gt; films_genres &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;ON&lt;/span&gt; films.id = films_genres.films_id&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;LEFT JOIN&lt;/span&gt; genres &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;ON&lt;/span&gt; genres.id = films_genres.genres_id&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;LEFT JOIN&lt;/span&gt; films_directors &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;ON&lt;/span&gt; films.id = films_directors.films_id&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;LEFT JOIN&lt;/span&gt; directors &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;ON&lt;/span&gt; directors.id = films_directors.directors_id&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;LEFT JOIN&lt;/span&gt; films_writers &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;ON&lt;/span&gt; films.id = films_writers.films_id&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;LEFT JOIN&lt;/span&gt; writers &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;ON&lt;/span&gt; writers.id = films_writers.writers_id&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;LEFT JOIN&lt;/span&gt; films_actors &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;ON&lt;/span&gt; films.id = films_actors.films_id&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;LEFT JOIN&lt;/span&gt; actors &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;ON&lt;/span&gt; actors.id = films_actors.actors_id&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;WHERE&lt;/span&gt; films.imdbID = &lt;span style=&quot;color: rgb(163, 21, 21);&quot;&gt;&#39;tt0108052&#39;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;GROUP BY&lt;/span&gt; films.id, films.title, films.year, films.runtime, films.imdbRating;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
