        <mxCell id="tlDhsTLVG-M8obE5rz7a-203" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;align=left;" value="&lt;div style=&quot;background-color: rgb(255, 255, 255); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; line-height: 18px; white-space: pre;&quot;&gt;&lt;div style=&quot;line-height: 18px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 255, 0));&quot;&gt;-- CREATE OR REPLACE VIEW v_film_stats AS&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;SELECT&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    films.id,&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    films.title,&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    films.year,&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    COUNT(&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;DISTINCT&lt;/span&gt; films_actors.id) &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;AS&lt;/span&gt; actors_count,&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;    COUNT(&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;DISTINCT&lt;/span&gt; comments.id) &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;AS&lt;/span&gt; comments_count&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;FROM&lt;/span&gt; films&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;LEFT JOIN&lt;/span&gt; films_actors &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;ON&lt;/span&gt; films_actors.films_id = films.id&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;LEFT JOIN&lt;/span&gt; comments &lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;ON&lt;/span&gt; comments.films_id = films.id&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 255);&quot;&gt;GROUP BY&lt;/span&gt; films.id, films.title, films.year;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="600" x="260" y="2090" as="geometry" />
        </mxCell>
